# Copy to .env and adjust if needed. Demo values only — no real secrets.
DB_NAME=dispatch
DB_USER=dispatch
DB_PASSWORD=dispatch
DB_PORT=5432
DISPATCH_PORT=8080
APP_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
CARRIER_PORT=8081
CARRIER_DB_NAME=carrier
CARRIER_DB_USER=carrier
CARRIER_DB_PASSWORD=carrier
# Fault mode delays of carrier-emulator; the lose-response delay must exceed dispatch's 5 s response timeout.
# CARRIER_LOSE_RESPONSE_DELAY=10s
# CARRIER_DELAYED_RESULT_DELAY=15s
