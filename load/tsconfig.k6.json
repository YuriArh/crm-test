{
  // Type checking only (pnpm typecheck): k6 runs the .ts files itself and strips the types, nothing is emitted.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["k6"],
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Only syntax k6 can strip without transforming (no enums, namespaces, parameter properties).
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    // k6 resolves imports by exact path: local imports carry the .ts extension.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules", "out"]
}
